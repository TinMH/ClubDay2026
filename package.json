{
  "name": "clubday",
  "version": "0.1.0",
  "private": true,
  "description": "Web 4 trò chơi cho sự kiện CLB — Tính nhanh, Vẽ hình nhanh (nhận diện AI), Nhớ nhanh, Ô khác màu",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build:contract && npm run build -w apps/web && npm run build -w apps/server",
    "start": "node apps/server/dist/index.js",
    "test": "npm run build:contract && npm run test -w apps/server && npm run test -w apps/web",
    "prefetch": "tsx scripts/prefetch-model.ts",
    "check:offline": "tsx scripts/check-offline.ts",
    "eval:model": "tsx scripts/eval-model.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "loadtest": "node scripts/load-test.mjs",
    "report:loadtest": "node scripts/report-loadtest.mjs",
    "build:contract": "npm run build -w @clubday/contract"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
