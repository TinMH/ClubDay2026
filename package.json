{
  "name": "clubday",
  "version": "0.1.0",
  "private": true,
  "description": "Web 2 trò chơi cho sự kiện CLB — Tính nhanh (90s) & Vẽ hình nhanh (15s, nhận diện AI)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "start": "node apps/server/dist/index.js",
    "test": "npm run test -w apps/server",
    "prefetch": "tsx scripts/prefetch-model.ts",
    "check:offline": "tsx scripts/check-offline.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
